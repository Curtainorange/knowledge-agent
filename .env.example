# ===== 认知副驾 P0 · 环境变量示例 =====
# 复制为 .env 后按需修改；未配置 DEEPSEEK_API_KEY 时网关自动路由到 MockProvider（确定性、零成本）。

# --- 应用 ---
DEBUG=false

# --- 数据库（P0 默认 SQLite，免基础设施）---
DATABASE_URL=sqlite:///./dev.db
# 生产/预发可切换 PostgreSQL：postgresql+psycopg://user:pass@host:5432/cognition

# --- DeepSeek（OpenAI 兼容协议）---
# 留空 → MockProvider；填入 → 真实 DeepSeekProvider
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60.0

# --- 单价（每百万 token，人民币；接入实测后回填，避免固锁失真）---
DEEPSEEK_PRICE_INPUT_PER_1M=1.0
DEEPSEEK_PRICE_OUTPUT_PER_1M=4.0

# --- Embedding（语义检索；独立于 LLM，DeepSeek 无标准 embedding 接口）---
# local：从 EMBEDDING_LOCAL_DIR 加载 ONNX，完全离线（推荐）
#        先用 python scripts/fetch_embedding_model.py 预取模型（走 ModelScope 镜像）
# bge  ：由 fastembed 自动从 HuggingFace 下载（需能访问 HF）
# hash ：确定性哈希，零依赖但语义弱（仅测试 / 应急）
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
EMBEDDING_LOCAL_DIR=models/bge-small-zh-v1.5

# --- 仅 bge 后端会用到：HuggingFace 下载（国内走镜像）---
# 若网络无法访问 hf-mirror.com / huggingface.co，请改用上面的 local 后端。
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
# 模型缺失或加载失败时，检索会自动降级为关键词召回（embed_status=embed_failed），
# 不阻断落库；补齐模型后重新录入或更新正文即可补上向量。

# --- 认证（JWT，见系统设计 9.3.1）---
# 生产务必配置 JWT_SECRET；留空则进程内随机生成，服务重启后所有已签发 token 立即失效。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=120
REFRESH_TOKEN_DAYS=7
PASSWORD_PBKDF2_ITERATIONS=600000

# --- 登录失败限流（进程内计数；多 worker 部署时各算各的，阈值等效放大）---
# 同窗口内按「账号」与「来源 IP」双维度计数，任一超限即拒绝（429 + Retry-After）。
LOGIN_THROTTLE_ENABLED=true
LOGIN_MAX_ATTEMPTS=5        # 按账号：失败上限，防针对单一账号爆破
LOGIN_IP_MAX_ATTEMPTS=20    # 按 IP：阈值放宽，避免公司/学校 NAT 后的正常用户被连带
LOGIN_WINDOW_SECONDS=300    # 失败计数滑动窗口
LOGIN_LOCK_SECONDS=300      # 触发上限后的锁定时长