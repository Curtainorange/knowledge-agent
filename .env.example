# ===== 认知副驾 P0 · 环境变量示例 =====
# 复制为 .env 后按需修改；未配置 DEEPSEEK_API_KEY 时网关自动路由到 MockProvider（确定性、零成本）。

# --- 应用 ---
DEBUG=false

# --- 数据库（P0 默认 SQLite，免基础设施）---
DATABASE_URL=sqlite:///./dev.db
# 生产/预发可切换 PostgreSQL：postgresql+psycopg://user:pass@host:5432/cognition

# --- DeepSeek（OpenAI 兼容协议）---
# 留空 → MockProvider；填入 → 真实 DeepSeekProvider
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60.0

# --- 单价（每百万 token，人民币；接入实测后回填，避免固锁失真）---
DEEPSEEK_PRICE_INPUT_PER_1M=1.0
DEEPSEEK_PRICE_OUTPUT_PER_1M=4.0

# --- Embedding（语义检索；本地 BGE 真语义，独立于 LLM）---
EMBEDDING_BACKEND=bge        # bge(本地真语义，默认) / hash(确定性零依赖，测试离线)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# --- Hugging Face 下载（国内需走镜像；模型已缓存后可省略）---
# 首次加载 BGE 会从 HF 下载模型，国内官方源常连接超时/被墙；这两项让 app 自行走镜像。
# 亦可用 shell `export HF_ENDPOINT=... HF_HUB_DISABLE_XET=1` 覆盖。
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1