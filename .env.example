# ===== 认知副驾 P0 · 环境变量示例 =====
# 复制为 .env 后按需修改；未配置 DEEPSEEK_API_KEY 时网关自动路由到 MockProvider（确定性、零成本）。

# --- 应用 ---
DEBUG=false

# --- 数据库（P0 默认 SQLite，免基础设施）---
DATABASE_URL=sqlite:///./dev.db
# 生产/预发可切换 PostgreSQL：postgresql+psycopg://user:pass@host:5432/cognition

# --- DeepSeek（OpenAI 兼容协议）---
# 留空 → MockProvider；填入 → 真实 DeepSeekProvider
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 官方模型名（2026-09 起）；旧名 deepseek-v4-flash 仍可调用但会重定向到同一模型
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60.0

# --- 单价（每百万 token，人民币）---
# 取自 DeepSeek 官方定价页，2026-09-13 核对；下表是**空闲时段**价。
# 高峰（北京时间工作日 9:00-12:00、14:00-18:00）价是空闲的两倍，由 PEAK_MULTIPLIER 放大，
# 因此不要把高峰价填进来。缓存命中价约为未命中的 1/50，务必单独填。
DEEPSEEK_PRICE_INPUT_PER_1M=1.0
DEEPSEEK_PRICE_OUTPUT_PER_1M=4.0
DEEPSEEK_PRICE_CACHE_HIT_PER_1M=0.02
DEEPSEEK_PEAK_MULTIPLIER=2.0
# 高峰时段（北京时间，周一至周五），格式 "起始-结束,起始-结束"；留空则全时段按空闲计价
DEEPSEEK_PEAK_HOURS=9-12,14-18

# --- Embedding（语义检索；独立于 LLM，DeepSeek 无标准 embedding 接口）---
# local：从 EMBEDDING_LOCAL_DIR 加载 ONNX，完全离线（推荐）
#        先用 python scripts/fetch_embedding_model.py 预取模型（走 ModelScope 镜像）
# bge  ：由 fastembed 自动从 HuggingFace 下载（需能访问 HF）
# hash ：确定性哈希，零依赖但语义弱（仅测试 / 应急）
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
EMBEDDING_LOCAL_DIR=models/bge-small-zh-v1.5

# --- 仅 bge 后端会用到：HuggingFace 下载（国内走镜像）---
# 若网络无法访问 hf-mirror.com / huggingface.co，请改用上面的 local 后端。
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
# 模型缺失或加载失败时，检索会自动降级为关键词召回（embed_status=embed_failed），
# 不阻断落库；补齐模型后重新录入或更新正文即可补上向量。

# --- 认证（JWT，见系统设计 9.3.1）---
# 生产务必配置 JWT_SECRET；留空则进程内随机生成，服务重启后所有已签发 token 立即失效。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=120
REFRESH_TOKEN_DAYS=7
PASSWORD_PBKDF2_ITERATIONS=600000

# --- 登录失败限流（进程内计数；多 worker 部署时各算各的，阈值等效放大）---
# 同窗口内按「账号」与「来源 IP」双维度计数，任一超限即拒绝（429 + Retry-After）。
LOGIN_THROTTLE_ENABLED=true
LOGIN_MAX_ATTEMPTS=5        # 按账号：失败上限，防针对单一账号爆破
LOGIN_IP_MAX_ATTEMPTS=20    # 按 IP：阈值放宽，避免公司/学校 NAT 后的正常用户被连带
LOGIN_WINDOW_SECONDS=300    # 失败计数滑动窗口
LOGIN_LOCK_SECONDS=300      # 触发上限后的锁定时长
# 注册按来源 IP 限流（每次注册都要跑 PBKDF2，是可被利用的 CPU 消耗点）。
# 统计全部注册尝试（含成功），因此阈值按「正常用户不会在窗口内注册这么多次」设。
REGISTER_MAX_ATTEMPTS_PER_IP=10

# --- 异步任务（单进程守护线程轮询；测试与只读场景可关掉）---
WORKER_ENABLED=true
WORKER_POLL_SECONDS=15.0
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BACKOFF_SECONDS=1.0

# --- L2 触发链路 ---
L2_REALTIME_TRIGGER_ENABLED=true   # 录入/划词后按小时桶合并触发扫描
L2_WEEKLY_SCAN_ENABLED=true        # 每周自动扫描（幂等键按 ISO 周去重）

# --- 微信读书同步（官方 AI Skills 接口，只读个人阅读数据）---
# API Key 在 https://weread.qq.com/r/weread-skills 扫码登录后新建，格式 wrk-xxxxxxxx。
# 留空则书架页的「同步微信读书」不可用（不影响其它功能）。
# ⚠️ Key 等同账号访问凭据：只填在本机 .env（已被 .gitignore 忽略），不要提交或分享。
WEREAD_API_KEY=
# 官方技能包版本；回包出现 upgrade_info 时，需按提示升级并同步这里的版本号
WEREAD_SKILL_VERSION=1.0.4
WEREAD_GATEWAY_URL=https://i.weread.qq.com/api/agent/gateway
WEREAD_TIMEOUT_SECONDS=20.0
WEREAD_MAX_ITEMS_PER_SYNC=300        # 单次同步条目上限，超出时提示「还有 N 本未扫描」
WEREAD_PAGE_SIZE=50                  # 笔记本概览的游标分页大小（官方无 offset 分页）
WEREAD_REQUEST_INTERVAL_SECONDS=0.3  # 逐本拉取间隔，避免触发官方限流