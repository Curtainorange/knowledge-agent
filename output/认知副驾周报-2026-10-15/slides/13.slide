<Slide style={{ width: 1280, height: 720, padding: '34px 72px 22px 72px', background: '#FFFFFF', flexDirection: 'column', fontFamily: "'Source Han Sans SC', 'Noto Sans SC', 'Microsoft YaHei', sans-serif" }}>

    <Box style={{ height: 84, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', borderBottom: '1px solid #E5E7EB', paddingBottom: 14 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 14 }}>
            <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#3730A3', fontFamily: "'JetBrains Mono', Consolas, monospace" }}>04</Text>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1F2430', letterSpacing: 0.5 }}>6 个提交 · 5 个里程碑 · 接口零改动</Text>
        </Box>
        <Text style={{ fontSize: 16, color: '#6B7280', paddingBottom: 6 }}>阶段 1：手机可用</Text>
    </Box>

    <Box style={{ height: 544, paddingTop: 20, flexDirection: 'column' }}>

        <Box style={{ height: 200, flexDirection: 'row', gap: 20 }}>

            <Box style={{ width: 420, height: '100%', background: '#F6F7FB', borderRadius: 16, padding: '18px 26px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 96, fontWeight: 'bold', color: '#0EA5E9', lineHeight: 1.0, letterSpacing: -3, fontFamily: "'JetBrains Mono', Consolas, monospace" }}>6</Text>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1F2430', marginTop: 10 }}>个串行提交，全部落地</Text>
                <Text style={{ fontSize: 14, color: '#6B7280', marginTop: 6 }}>阶段 1 计划拆成 M1–M5 五个里程碑，一共六个 commit</Text>
            </Box>

            <Box style={{ flex: 1, height: '100%', background: '#F6F7FB', borderRadius: 16 }}>
                <svg width={692} height={200} viewBox='0 0 692 200'>
                    <text x='28' y='34' fontSize='15' fontWeight='bold' fill='#3730A3'>阶段 1 的六个提交：一次只动一层，随时可停</text>

                    <rect x='28' y='72' width='98' height='40' rx='6' fill='#3730A3' opacity='0.38' />
                    <rect x='134' y='72' width='98' height='40' rx='6' fill='#3730A3' opacity='0.52' />
                    <rect x='240' y='72' width='98' height='40' rx='6' fill='#3730A3' opacity='0.65' />
                    <rect x='346' y='72' width='98' height='40' rx='6' fill='#3730A3' opacity='0.78' />
                    <rect x='452' y='72' width='98' height='40' rx='6' fill='#3730A3' opacity='0.9' />
                    <rect x='558' y='72' width='98' height='40' rx='6' fill='#0EA5E9' />

                    <text x='77' y='62' fontSize='11' fill='#6B7280' textAnchor='middle' fontFamily='monospace'>M1</text>
                    <text x='183' y='62' fontSize='11' fill='#6B7280' textAnchor='middle' fontFamily='monospace'>M2a</text>
                    <text x='289' y='62' fontSize='11' fill='#6B7280' textAnchor='middle' fontFamily='monospace'>M2b</text>
                    <text x='395' y='62' fontSize='11' fill='#6B7280' textAnchor='middle' fontFamily='monospace'>M3</text>
                    <text x='501' y='62' fontSize='11' fill='#6B7280' textAnchor='middle' fontFamily='monospace'>M4</text>
                    <text x='607' y='62' fontSize='11' fill='#6B7280' textAnchor='middle' fontFamily='monospace'>M5</text>

                    <text x='77' y='134' fontSize='12' fill='#1F2430' textAnchor='middle'>全局骨架</text>
                    <text x='183' y='134' fontSize='12' fill='#1F2430' textAnchor='middle'>高频三页</text>
                    <text x='289' y='134' fontSize='12' fill='#1F2430' textAnchor='middle'>其余八页</text>
                    <text x='395' y='134' fontSize='12' fill='#1F2430' textAnchor='middle'>阅读器</text>
                    <text x='501' y='134' fontSize='12' fill='#1F2430' textAnchor='middle'>PWA</text>
                    <text x='607' y='134' fontSize='12' fill='#1F2430' textAnchor='middle'>局域网</text>

                    <text x='28' y='176' fontSize='13' fill='#6B7280'>执行期用例 650 → 660 项；桌面端布局零变化</text>
                    <rect x='512' y='156' width='144' height='28' rx='14' fill='#EEEDFE' />
                    <text x='584' y='175' fontSize='13' fill='#3730A3' textAnchor='middle'>接口零改动</text>
                </svg>
            </Box>

        </Box>

        <Box style={{ height: 60, marginTop: 16, flexDirection: 'row', alignItems: 'center', gap: 22, padding: '0px 24px', background: '#EEEDFE', borderRadius: 10 }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#3730A3', fontFamily: "'JetBrains Mono', Consolas, monospace" }}>5</Text>
            <Text style={{ fontSize: 15, color: '#1F2430' }}>个里程碑（M1 → M5）</Text>
            <Box style={{ width: 1, height: 26, background: '#C7D2FE' }} />
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#3730A3', fontFamily: "'JetBrains Mono', Consolas, monospace" }}>0</Text>
            <Text style={{ fontSize: 15, color: '#1F2430' }}>处接口改动</Text>
            <Box style={{ width: 1, height: 26, background: '#C7D2FE' }} />
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#3730A3', fontFamily: "'JetBrains Mono', Consolas, monospace" }}>660</Text>
            <Text style={{ fontSize: 15, color: '#1F2430' }}>项全量用例（执行期 +10）</Text>
        </Box>

        <Box style={{ height: 232, marginTop: 16, flexDirection: 'column' }}>
            <Text style={{ fontSize: 15, color: '#1F2430', lineHeight: 1.6, background: '#F6F7FB', borderLeft: '3px solid #0EA5E9', borderRadius: 8, padding: '12px 16px' }}>纯 Web 底子（13 个页面 + REST + JWT）天然多端复用，所以花掉的是适配成本，不是移植成本。</Text>

            <Box style={{ flexDirection: 'row', alignItems: 'stretch', gap: 12, marginTop: 16 }}>
                <Box style={{ flex: 1.4, background: '#3730A3', borderRadius: 12, padding: '16px 18px', flexDirection: 'column' }}>
                    <Text style={{ fontSize: 13, color: '#A5B4FC', fontFamily: "'JetBrains Mono', Consolas, monospace" }}>PHASE 1　已落地</Text>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF', marginTop: 10 }}>手机可用</Text>
                    <Text style={{ fontSize: 14, color: '#C7D2FE', lineHeight: 1.6, marginTop: 8 }}>响应式 + PWA + 局域网可达；等真机验收</Text>
                </Box>
                <Box style={{ flex: 1.1, background: '#F6F7FB', borderRadius: 12, padding: '16px 18px', flexDirection: 'column' }}>
                    <Text style={{ fontSize: 13, color: '#6B7280', fontFamily: "'JetBrains Mono', Consolas, monospace" }}>PHASE 2</Text>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1F2430', marginTop: 10 }}>随身好用</Text>
                    <Text style={{ fontSize: 14, color: '#6B7280', lineHeight: 1.6, marginTop: 8 }}>通知角标 + 可选外发 + 云部署，待真机反馈排期</Text>
                </Box>
                <Box style={{ flex: 0.9, background: '#F6F7FB', borderRadius: 12, padding: '16px 18px', flexDirection: 'column' }}>
                    <Text style={{ fontSize: 13, color: '#6B7280', fontFamily: "'JetBrains Mono', Consolas, monospace" }}>PHASE 3</Text>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1F2430', marginTop: 10 }}>按需再议</Text>
                    <Text style={{ fontSize: 14, color: '#6B7280', lineHeight: 1.6, marginTop: 8 }}>Capacitor 壳 / 小程序</Text>
                </Box>
            </Box>
        </Box>

    </Box>

    <Box style={{ height: 36, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 13, color: '#6B7280' }}>认知副驾 · 周技术汇报</Text>
        <Text style={{ fontSize: 13, color: '#6B7280', fontFamily: "'JetBrains Mono', Consolas, monospace" }}>13 / 16</Text>
    </Box>

</Slide>
