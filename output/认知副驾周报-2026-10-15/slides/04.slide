<Slide style={{ width: 1280, height: 720, padding: '34px 72px 22px 72px', background: '#FFFFFF', flexDirection: 'column', fontFamily: "'Source Han Sans SC', 'Noto Sans SC', 'Microsoft YaHei', sans-serif" }}>

    <Box style={{ height: 84, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', borderBottom: '1px solid #E5E7EB', paddingBottom: 14 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 14 }}>
            <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#3730A3', fontFamily: "'JetBrains Mono', Consolas, monospace" }}>01</Text>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1F2430', letterSpacing: 0.5 }}>本周 8 次提交 · 全量用例 680 项</Text>
        </Box>
        <Text style={{ fontSize: 16, color: '#6B7280', paddingBottom: 6 }}>10-12 至 10-13</Text>
    </Box>

    <Box style={{ height: 544, paddingTop: 20, flexDirection: 'column' }}>

        <Box style={{ height: 230, flexDirection: 'row', gap: 20 }}>

            <Box style={{ width: 400, height: '100%', background: '#F6F7FB', borderRadius: 16, padding: '22px 28px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 92, fontWeight: 'bold', color: '#3730A3', lineHeight: 1.0, letterSpacing: -2, fontFamily: "'JetBrains Mono', Consolas, monospace" }}>680</Text>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1F2430', marginTop: 12 }}>全量自动化用例</Text>
                <Text style={{ fontSize: 15, color: '#6B7280', marginTop: 6 }}>本周 +4 项；其中 2 项为条件跳过</Text>
            </Box>

            <Box style={{ flex: 1, height: '100%', background: '#F6F7FB', borderRadius: 16, padding: '20px 24px', flexDirection: 'column' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1F2430' }}>用例数增长：近三次检查点只增加 20 项</Text>
                <svg width={640} height={140} viewBox='0 0 640 140' style={{ marginTop: 12 }}>
                    <line x1='40' y1='110' x2='610' y2='110' stroke='#E5E7EB' strokeWidth='1' />
                    <polyline points='40,110 180,60 320,53 460,42 590,38' fill='none' stroke='#3730A3' strokeWidth='2' />
                    <circle cx='40' cy='110' r='4' fill='#3730A3' />
                    <circle cx='180' cy='60' r='4' fill='#3730A3' />
                    <circle cx='320' cy='53' r='4' fill='#3730A3' />
                    <circle cx='460' cy='42' r='4' fill='#3730A3' />
                    <circle cx='590' cy='38' r='6' fill='#0EA5E9' />
                    <text x='40' y='100' fontSize='12' fill='#6B7280' textAnchor='middle' fontFamily='monospace'>522</text>
                    <text x='180' y='50' fontSize='12' fill='#6B7280' textAnchor='middle' fontFamily='monospace'>650</text>
                    <text x='320' y='43' fontSize='12' fill='#6B7280' textAnchor='middle' fontFamily='monospace'>660</text>
                    <text x='460' y='32' fontSize='12' fill='#6B7280' textAnchor='middle' fontFamily='monospace'>676</text>
                    <text x='590' y='28' fontSize='13' fill='#0EA5E9' textAnchor='middle' fontFamily='monospace'>680</text>
                    <text x='40' y='132' fontSize='11' fill='#6B7280' textAnchor='middle'>09-23</text>
                    <text x='180' y='132' fontSize='11' fill='#6B7280' textAnchor='middle'>10-02</text>
                    <text x='320' y='132' fontSize='11' fill='#6B7280' textAnchor='middle'>10-02</text>
                    <text x='460' y='132' fontSize='11' fill='#6B7280' textAnchor='middle'>10-12</text>
                    <text x='590' y='132' fontSize='11' fill='#6B7280' textAnchor='middle'>10-13</text>
                </svg>
            </Box>

        </Box>

        <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', marginTop: 18, paddingLeft: 16, background: '#EEEDFE', borderRadius: 8, borderLeft: '3px solid #0EA5E9' }}>
            <Text style={{ fontSize: 16, color: '#1F2430' }}>增量的重心已经换位：这一周不在功能数量，而在把入口和边界做干净。</Text>
        </Box>

        <Box style={{ height: 218, marginTop: 18, flexDirection: 'column', gap: 13 }}>

            <Box style={{ height: 64, flexDirection: 'row', alignItems: 'center', gap: 16, padding: '0px 20px', background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 10 }}>
                <Box style={{ width: 34, height: 34, borderRadius: 10, background: '#EEEDFE', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#3730A3', fontFamily: "'JetBrains Mono', Consolas, monospace" }}>01</Text>
                </Box>
                <Box style={{ flexDirection: 'column', flex: 1 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1F2430' }}>对话工作台新增历史侧栏</Text>
                    <Text style={{ fontSize: 14, color: '#6B7280', marginTop: 4 }}>列表 / 重命名 / 删除，首条消息自动命名；后端 13 例 + 前端渲染 17 项</Text>
                </Box>
            </Box>

            <Box style={{ height: 64, flexDirection: 'row', alignItems: 'center', gap: 16, padding: '0px 20px', background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 10 }}>
                <Box style={{ width: 34, height: 34, borderRadius: 10, background: '#EEEDFE', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#3730A3', fontFamily: "'JetBrains Mono', Consolas, monospace" }}>02</Text>
                </Box>
                <Box style={{ flexDirection: 'column', flex: 1 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1F2430' }}>检测记录与挖掘记录不再进对话历史</Text>
                    <Text style={{ fontSize: 14, color: '#6B7280', marginTop: 4 }}>新增 kind 过滤（chat / l1 / l2 / all），读时派生、零迁移，分页在过滤之后切</Text>
                </Box>
            </Box>

            <Box style={{ height: 64, flexDirection: 'row', alignItems: 'center', gap: 16, padding: '0px 20px', background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 10 }}>
                <Box style={{ width: 34, height: 34, borderRadius: 10, background: '#EEEDFE', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#3730A3', fontFamily: "'JetBrains Mono', Consolas, monospace" }}>03</Text>
                </Box>
                <Box style={{ flexDirection: 'column', flex: 1 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1F2430' }}>修复微信读书同步中断</Text>
                    <Text style={{ fontSize: 14, color: '#6B7280', marginTop: 4 }}>官方技能包升到 1.0.5（服务端强校验版本）；真实链路同步 2 本 / 新建 5 条 / 0 失败</Text>
                </Box>
            </Box>

        </Box>

    </Box>

    <Box style={{ height: 36, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 13, color: '#6B7280' }}>认知副驾 · 周技术汇报</Text>
        <Text style={{ fontSize: 13, color: '#6B7280', fontFamily: "'JetBrains Mono', Consolas, monospace" }}>04 / 16</Text>
    </Box>

</Slide>
