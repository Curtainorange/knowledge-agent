<Slide style={{ width: 1280, height: 720, padding: '34px 72px 22px 72px', background: '#FFFFFF', flexDirection: 'column', fontFamily: "'Source Han Sans SC', 'Noto Sans SC', 'Microsoft YaHei', sans-serif" }}>

    <Box style={{ height: 84, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', borderBottom: '1px solid #E5E7EB', paddingBottom: 14 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 14 }}>
            <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#3730A3', fontFamily: "'JetBrains Mono', Consolas, monospace" }}>02</Text>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1F2430', letterSpacing: 0.5 }}>Harness：模型之外的那台运行机器</Text>
        </Box>
        <Text style={{ fontSize: 16, color: '#6B7280', paddingBottom: 6 }}>「对话即入口」本身就是一台 harness</Text>
    </Box>

    <Box style={{ height: 544, paddingTop: 20, flexDirection: 'column' }}>

        <Box style={{ height: 320, background: '#F6F7FB', borderRadius: 16 }}>
            <svg width={1136} height={320} viewBox='0 0 1136 320'>
                <defs>
                    <marker id='ar' viewBox='0 0 10 10' refX='8' refY='5' markerWidth='6' markerHeight='6' orient='auto-start-reverse'>
                        <path d='M2 1L8 5L2 9' fill='none' stroke='#3730A3' strokeWidth='1.5' strokeLinecap='round' strokeLinejoin='round' />
                    </marker>
                    <marker id='ar2' viewBox='0 0 10 10' refX='8' refY='5' markerWidth='6' markerHeight='6' orient='auto-start-reverse'>
                        <path d='M2 1L8 5L2 9' fill='none' stroke='#0EA5E9' strokeWidth='1.5' strokeLinecap='round' strokeLinejoin='round' />
                    </marker>
                </defs>

                <text x='50' y='44' fontSize='15' fontWeight='bold' fill='#3730A3'>一次对话回合 ＝ 一次 Harness 运行</text>
                <text x='50' y='68' fontSize='13' fill='#6B7280'>每一步都在模型之外，负责权限、状态与可恢复性——不负责措辞</text>

                <rect x='50' y='100' width='180' height='88' rx='12' fill='#EEEDFE' stroke='#3730A3' strokeWidth='1' />
                <text x='140' y='138' fontSize='15' fontWeight='bold' fill='#1F2430' textAnchor='middle'>意图路由</text>
                <text x='140' y='162' fontSize='12' fill='#6B7280' textAnchor='middle'>命令式走本地规则</text>

                <rect x='264' y='100' width='180' height='88' rx='12' fill='#EEEDFE' stroke='#3730A3' strokeWidth='1' />
                <text x='354' y='138' fontSize='15' fontWeight='bold' fill='#1F2430' textAnchor='middle'>能力分发</text>
                <text x='354' y='162' fontSize='12' fill='#6B7280' textAnchor='middle'>10 项能力分发表</text>

                <rect x='478' y='100' width='180' height='88' rx='12' fill='#EEEDFE' stroke='#0EA5E9' strokeWidth='1.5' />
                <text x='568' y='138' fontSize='15' fontWeight='bold' fill='#1F2430' textAnchor='middle'>前提检查</text>
                <text x='568' y='162' fontSize='12' fill='#6B7280' textAnchor='middle'>缺 Key / 缺目标不发卡</text>

                <rect x='692' y='100' width='180' height='88' rx='12' fill='#EEEDFE' stroke='#3730A3' strokeWidth='1' />
                <text x='782' y='138' fontSize='15' fontWeight='bold' fill='#1F2430' textAnchor='middle'>执行</text>
                <text x='782' y='162' fontSize='12' fill='#6B7280' textAnchor='middle'>同步，或转后台</text>

                <rect x='906' y='100' width='180' height='88' rx='12' fill='#EEEDFE' stroke='#3730A3' strokeWidth='1' />
                <text x='996' y='138' fontSize='15' fontWeight='bold' fill='#1F2430' textAnchor='middle'>卡片回写</text>
                <text x='996' y='162' fontSize='12' fill='#6B7280' textAnchor='middle'>结果落回会话消息</text>

                <line x1='232' y1='144' x2='260' y2='144' stroke='#3730A3' strokeWidth='1.5' markerEnd='url(#ar)' />
                <line x1='446' y1='144' x2='474' y2='144' stroke='#3730A3' strokeWidth='1.5' markerEnd='url(#ar)' />
                <line x1='660' y1='144' x2='688' y2='144' stroke='#3730A3' strokeWidth='1.5' markerEnd='url(#ar)' />
                <line x1='874' y1='144' x2='902' y2='144' stroke='#3730A3' strokeWidth='1.5' markerEnd='url(#ar)' />

                <rect x='478' y='228' width='180' height='56' rx='12' fill='#FFFFFF' stroke='#0EA5E9' strokeWidth='1.5' />
                <text x='568' y='252' fontSize='14' fontWeight='bold' fill='#0EA5E9' textAnchor='middle'>后台 worker</text>
                <text x='568' y='272' fontSize='12' fill='#6B7280' textAnchor='middle'>跑完就地改写那条消息</text>

                <line x1='568' y1='188' x2='568' y2='224' stroke='#0EA5E9' strokeWidth='1.5' markerEnd='url(#ar2)' />
                <path d='M 568 284 L 568 302 L 996 302 L 996 192' fill='none' stroke='#0EA5E9' strokeWidth='1.5' strokeDasharray='4 4' markerEnd='url(#ar2)' />
            </svg>
        </Box>

        <Box style={{ height: 188, marginTop: 16, flexDirection: 'row', gap: 20 }}>

            <Box style={{ width: 720, height: '100%', background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 12, padding: '16px 22px', flexDirection: 'column' }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1F2430' }}>Harness 在本项目里的三件事</Text>
                <Box style={{ flexDirection: 'column', gap: 8, marginTop: 10 }}>
                    <Text style={{ fontSize: 14, color: '#1F2430', lineHeight: 1.5 }}><span style={{ fontWeight: 'bold', color: '#3730A3' }}>权限　</span>本地规则能判的绝不问模型；判不出来才调，且该调用固定关掉思考模式——因为它每轮都跑。</Text>
                    <Text style={{ fontSize: 14, color: '#1F2430', lineHeight: 1.5 }}><span style={{ fontWeight: 'bold', color: '#3730A3' }}>状态　</span>异步不引新表、不引消息队列，状态直接落在会话消息上：先写「进行中」，跑完就地改成结果。</Text>
                    <Text style={{ fontSize: 14, color: '#1F2430', lineHeight: 1.5 }}><span style={{ fontWeight: 'bold', color: '#3730A3' }}>恢复　</span>没有后台进程时自动退回同步执行，任务失败落成失败卡并给重试落点，而不是永远转圈。</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, height: '100%', background: '#EEEDFE', borderRadius: 12, padding: '16px 20px', flexDirection: 'column', justifyContent: 'center' }}>
                <Text style={{ fontSize: 15, color: '#1F2430', lineHeight: 1.7 }}>Harness 出错要修补的是系统，让同一类错误<span style={{ fontWeight: 'bold' }}>不再发生</span>；Prompt 出错改一句话术就行——两者不能混着修。</Text>
            </Box>

        </Box>

    </Box>

    <Box style={{ height: 36, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 13, color: '#6B7280' }}>认知副驾 · 周技术汇报</Text>
        <Text style={{ fontSize: 13, color: '#6B7280', fontFamily: "'JetBrains Mono', Consolas, monospace" }}>08 / 16</Text>
    </Box>

</Slide>
