<Slide style={{ width: 1280, height: 720, padding: '60px 60px 0 60px', background: '#FFFFFF', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', height: 18 }}>
        <Text style={{ fontSize: 14, color: '#94A3B8' }}>认知副驾 · 功能汇报</Text>
        <Text style={{ fontSize: 14, color: '#94A3B8' }}>2026-11-11</Text>
    </Box>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1F2937', marginTop: 14 }}>技术重点一：让每条建议说得出出处</Text>
    <Box style={{ width: 1160, height: 1, background: '#E2E8F0', marginTop: 12 }} />

    <Box style={{ flexDirection: 'row', gap: 32, marginTop: 22, height: 472 }}>
        <Box style={{ width: 840 }}>
            <Image src="assets/fig_grounding.png" style={{ width: 840, height: 472, objectFit: 'contain' }} />
        </Box>

        <Box style={{ width: 288, flexDirection: 'column', justifyContent: 'center', gap: 18 }}>
            <Box style={{ flexDirection: 'column' }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1F2937' }}>规则只实现一次</Text>
                <Text style={{ fontSize: 16, color: '#475569', marginTop: 6, lineHeight: 1.55 }}>
                    L1 / L3 / L4 / L5 与对话建议都从这里取依据，不各自拼证据
                </Text>
            </Box>
            <Box style={{ width: 288, height: 1, background: '#E2E8F0' }} />
            <Box style={{ flexDirection: 'column' }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1F2937' }}>提示词约束不了幻觉</Text>
                <Text style={{ fontSize: 16, color: '#475569', marginTop: 6, lineHeight: 1.55 }}>
                    写「不许编造 id」没有用；能拦住的是把校验写成代码
                </Text>
            </Box>
            <Box style={{ width: 288, height: 1, background: '#E2E8F0' }} />
            <Box style={{ flexDirection: 'column' }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1F2937' }}>宁可不出，也不乱出</Text>
                <Text style={{ fontSize: 16, color: '#475569', marginTop: 6, lineHeight: 1.55 }}>
                    依据不够时返回「缺什么」，而不是给一条听起来对的建议
                </Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', bottom: 20, right: 60 }}>
        <Text style={{ fontSize: 14, color: '#94A3B8' }}>22</Text>
    </Box>
</Slide>
