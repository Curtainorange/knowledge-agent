<Slide style={{ width: 1280, height: 720, padding: '60px 60px 0 60px', background: '#FFFFFF', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', height: 18 }}>
        <Text style={{ fontSize: 14, color: '#94A3B8' }}>认知副驾 · 功能汇报</Text>
        <Text style={{ fontSize: 14, color: '#94A3B8' }}>2026-11-11</Text>
    </Box>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1F2937', marginTop: 14 }}>五级漏斗：模型只在中间两级说话</Text>
    <Box style={{ width: 1160, height: 1, background: '#E2E8F0', marginTop: 12 }} />

    <Box style={{ flexDirection: 'row', gap: 32, marginTop: 24, height: 470 }}>
        <Box style={{ width: 760, flexDirection: 'column' }}>
            <Image src="assets/fig_funnel.png" style={{ width: 760, height: 428, objectFit: 'contain' }} />
        </Box>

        <Box style={{ width: 368, flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'column' }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#4F46E5' }}>该在代码里的，不交给模型</Text>
                <Text style={{ fontSize: 17, color: '#475569', marginTop: 8, lineHeight: 1.6 }}>
                    增量筛选、候选召回、置信度校准、复核触发，四件事都是本地纯函数，可单测。
                </Text>
            </Box>

            <Box style={{ width: 368, height: 1, background: '#E2E8F0', marginTop: 20 }} />

            <Box style={{ flexDirection: 'column', marginTop: 20 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#4F46E5' }}>不裸信模型自报的置信度</Text>
                <Text style={{ fontSize: 17, color: '#475569', marginTop: 8, lineHeight: 1.6 }}>
                    按证据充分度缩放、按信号一致性微调；证据不足或自相矛盾就触发复核。
                </Text>
            </Box>

            <Box style={{ width: 368, height: 1, background: '#E2E8F0', marginTop: 20 }} />

            <Box style={{ flexDirection: 'column', marginTop: 20 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#4F46E5' }}>判得准不准，是可量化的</Text>
                <Text style={{ fontSize: 17, color: '#475569', marginTop: 8, lineHeight: 1.6 }}>
                    人工标注集算关系准确率、矛盾 P / R / F1、置信度校准（ECE、Brier）。
                </Text>
            </Box>

            <Box style={{ width: 368, height: 62, background: '#EEF2FF', borderRadius: 8, marginTop: 22, justifyContent: 'center', padding: '0 16px' }}>
                <Text style={{ fontSize: 16, color: '#4F46E5', lineHeight: 1.5 }}>
                    5 级漏斗里，只有「判定」和「归因」两级会调用模型
                </Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', bottom: 20, right: 60 }}>
        <Text style={{ fontSize: 14, color: '#94A3B8' }}>16</Text>
    </Box>
</Slide>
