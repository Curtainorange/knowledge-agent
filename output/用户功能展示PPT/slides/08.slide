  </Box>
  <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16 }} />

  <Box style={{ flexDirection: 'row', gap: 36, marginTop: 28 }}>
    <Box style={{ width: 740, flexDirection: 'column' }}>
      <Image src="assets/books.jpg" style={{ width: 740, height: 407, borderRadius: 8, border: '1px solid #EDE9FE', objectFit: 'cover' }} />
      <Text style={{ fontSize: 14, color: '#9CA3AF', marginTop: 12, fontFamily: '微软雅黑' }}>
        真实界面 · 上传后自动分章节，进度按已读字数实时算
      </Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'flex-end', gap: 8 }}>
        <Text style={{ fontSize: 92, fontWeight: 'bold', color: '#7C3AED', lineHeight: 1, fontFamily: 'Helvetica' }}>11</Text>
        <Text style={{ fontSize: 16, color: '#6B7280', marginBottom: 10, fontFamily: '微软雅黑' }}>本在架</Text>
