<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', flexDirection: 'column' }}>
  <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
    <Box style={{ width: 6, height: 26, background: '#7C3AED', borderRadius: 3 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B', fontFamily: '微软雅黑' }}>
      从书里抠出一条，今天就能试
    </Text>
  </Box>
  <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16 }} />

  <Image src="assets/chat_suggestion.jpg" style={{ width: 700, height: 385, borderRadius: 8, border: '1px solid #EDE9FE', objectFit: 'cover', marginTop: 24 }} />
  <Text style={{ fontSize: 14, color: '#9CA3AF', marginTop: 10, fontFamily: '微软雅黑' }}>
    真实界面 · 每条建议都带「依据」，末尾挂「我去做了 / 这条不对」
  </Text>

  <Box style={{ flexDirection: 'row', gap: 26, marginTop: 22 }}>
    <Box style={{ flex: 5, flexDirection: 'column' }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#7C3AED', fontFamily: '微软雅黑' }}>
        它给的是动作，不是道理
      </Text>
      <Text style={{ fontSize: 16, color: '#4B5563', lineHeight: 1.6, marginTop: 8, fontFamily: '微软雅黑' }}>
        「会议开头先问一句这次会只解决哪件事」——照做就有反馈
      </Text>
    </Box>
    <Box style={{ flex: 3, flexDirection: 'column' }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#7C3AED', fontFamily: '微软雅黑' }}>
        依据可回查
      </Text>
      <Text style={{ fontSize: 16, color: '#4B5563', lineHeight: 1.6, marginTop: 8, fontFamily: '微软雅黑' }}>
        每条都指回《高效能人士的七个习惯》第 24 节
      </Text>
    </Box>
    <Box style={{ flex: 2, flexDirection: 'column' }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#7C3AED', fontFamily: '微软雅黑' }}>
        我能反驳
      </Text>
      <Text style={{ fontSize: 16, color: '#4B5563', lineHeight: 1.6, marginTop: 8, fontFamily: '微软雅黑' }}>
        点「这条不对」，它就记住这条不适用
      </Text>
    </Box>
  </Box>
</Slide>
