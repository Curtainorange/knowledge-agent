<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', flexDirection: 'column' }}>
    <Box style={{ width: '100%', height: 8, background: '#1E4FA8' }} />
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end', padding: '16px 40px 8px 40px' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>演示实录 ① · 对话录入</Text>
        <Text style={{ fontSize: 17, color: '#8B97A8' }}>系统真实运行界面 · 未作修饰</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 24, padding: '2px 40px 0 40px' }}>
        <Box style={{ width: 580, flexDirection: 'column', gap: 10 }}>
            <Image src="assets/demo1_input.png" style={{ width: 580, height: 461, objectFit: 'contain', borderRadius: 8, border: '1px solid #D6DCE5' }} />
            <Text style={{ fontSize: 16, color: '#8B97A8', lineHeight: 1.5 }}>输入框里只有一句话，系统返回的是一张可追溯的知识卡，而不是一段聊天回复。</Text>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'space-between' }}>
            <Box style={{ height: 176, background: '#F7F9FC', borderRadius: 10, border: '1px solid #D6DCE5', borderLeft: '5px solid #1E4FA8', padding: '14px 18px', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1A2230' }}>一句话即入口</Text>
                <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.55 }}>
                    命令式说法（「记一下…」「同步微信读书」）走本地确定性规则、零模型调用，只有判不出来时才问模型——因为它每一轮都要跑。
                </Text>
                <Text style={{ fontSize: 15, color: '#8B97A8' }}>10 项能力全部接入同一入口</Text>
            </Box>
            <Box style={{ height: 176, background: '#F7F9FC', borderRadius: 10, border: '1px solid #D6DCE5', borderLeft: '5px solid #1E4FA8', padding: '14px 18px', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1A2230' }}>结果以卡片回写会话</Text>
                <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.55 }}>
                    卡片协议是前后端唯一契约；耗时能力先回「进行中」卡，后台跑完就地改写那条消息，重新打开看到的是最终状态而不是转圈。
                </Text>
                <Text style={{ fontSize: 15, color: '#8B97A8' }}>同步与异步共用同一段执行逻辑</Text>
            </Box>
            <Box style={{ height: 176, background: '#F7F9FC', borderRadius: 10, border: '1px solid #D6DCE5', borderLeft: '5px solid #1E4FA8', padding: '14px 18px', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1A2230' }}>落库即参与全链路</Text>
                <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.55 }}>
                    条目写入后立刻可被检索、可参与 L2 扫描、可进简报与诊断——不需要额外的同步动作，这是「录入即资产」。
                </Text>
                <Text style={{ fontSize: 15, color: '#8B97A8' }}>与手写笔记、微信读书划线同等对待</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: '10px 40px 14px 40px' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>认知副驾 · Cognitive Copilot</Text>
        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>21 / 27</Text>
    </Box>
</Slide>
