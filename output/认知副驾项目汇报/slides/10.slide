<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', flexDirection: 'column' }}>
    <Box style={{ width: '100%', height: 8, background: '#1E4FA8' }} />
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end', padding: '16px 40px 8px 40px' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>技术二 · RAG 检索工程</Text>
        <Text style={{ fontSize: 17, color: '#8B97A8' }}>本地向量 · 双通道召回 · 排名融合 · 评估护栏</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 10, padding: '2px 40px 0 40px' }}>
        <Box style={{ background: '#F7F9FC', borderRadius: 10, border: '1px solid #D6DCE5', padding: '10px 14px' }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', textAlign: 'center' }}>RAG 与生成全链路 —— 八个环节，除重排外全部落地</Text>
            <svg width={1160} height={146} viewBox='0 0 1160 146'>
                <rect x='6' y='26' width='178' height='62' rx='8' fill='#E8EFF8' stroke='#3D7BD9' strokeWidth='1' />
                <text x='95' y='52' fontSize='17' fill='#0E3F8C' textAnchor='middle' fontWeight='bold'>知识录入</text>
                <text x='95' y='74' fontSize='13' fill='#4A5568' textAnchor='middle'>条目即分块</text>
                <polygon points='186,51 200,57 186,63' fill='#3D7BD9' />
                <rect x='200' y='26' width='178' height='62' rx='8' fill='#E8EFF8' stroke='#3D7BD9' strokeWidth='1' />
                <text x='289' y='52' fontSize='17' fill='#0E3F8C' textAnchor='middle' fontWeight='bold'>向量化</text>
                <text x='289' y='74' fontSize='13' fill='#4A5568' textAnchor='middle'>BGE 本地离线 · 512 维</text>
                <polygon points='380,51 394,57 380,63' fill='#3D7BD9' />
                <rect x='394' y='26' width='178' height='62' rx='8' fill='#E8EFF8' stroke='#3D7BD9' strokeWidth='1' />
                <text x='483' y='52' fontSize='17' fill='#0E3F8C' textAnchor='middle' fontWeight='bold'>混合召回</text>
                <text x='483' y='74' fontSize='13' fill='#4A5568' textAnchor='middle'>向量 ＋ 关键词双通道</text>
                <polygon points='574,51 588,57 574,63' fill='#3D7BD9' />
                <rect x='588' y='26' width='178' height='62' rx='8' fill='#E8EFF8' stroke='#3D7BD9' strokeWidth='1' />
                <text x='677' y='52' fontSize='17' fill='#0E3F8C' textAnchor='middle' fontWeight='bold'>RRF 融合</text>
                <text x='677' y='74' fontSize='13' fill='#4A5568' textAnchor='middle'>按排名 · 免调参</text>
                <polygon points='768,51 782,57 768,63' fill='#3D7BD9' />
                <rect x='782' y='26' width='178' height='62' rx='8' fill='#FFC107' opacity='0.9' />
                <text x='871' y='52' fontSize='17' fill='#1A2230' textAnchor='middle' fontWeight='bold'>评估护栏</text>
                <text x='871' y='74' fontSize='13' fill='#1A2230' textAnchor='middle'>recall@5 ≥ 0.95</text>
                <polygon points='962,51 976,57 962,63' fill='#3D7BD9' />
                <rect x='976' y='26' width='178' height='62' rx='8' fill='#0E3F8C' />
                <text x='1065' y='52' fontSize='17' fill='#FFFFFF' textAnchor='middle' fontWeight='bold'>受约束生成</text>
                <text x='1065' y='74' fontSize='13' fill='#BBD0F0' textAnchor='middle'>Schema 约束 6/6</text>
                <text x='6' y='120' fontSize='14' fill='#8B97A8'>检索失败自动降级关键词通道，不丢条目、不阻断主链路；嵌入模型记录版本，可增量重建；单用户规模下未启用重排与查询改写——取舍已登记。</text>
            </svg>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 12 }}>
            <Box style={{ flex: 1, height: 176, background: '#F7F9FC', borderRadius: 10, border: '1px solid #D6DCE5', borderTop: '4px solid #1E4FA8', padding: '13px 16px', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>本地向量模型 · BGE</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.55 }}>
                    bge-small-zh-v1.5 · 512 维 · ONNX 离线部署 · 输出 L2 归一化（归一后余弦等价于内积）。
                </Text>
                <Text style={{ fontSize: 15, color: '#8B97A8' }}>不依赖对话模型的接口 · 离线可复现 · 零调用成本</Text>
            </Box>
            <Box style={{ flex: 1, height: 176, background: '#F7F9FC', borderRadius: 10, border: '1px solid #D6DCE5', borderTop: '4px solid #1E4FA8', padding: '13px 16px', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>双通道召回 ＋ RRF 融合</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.55 }}>
                    向量管语义相近（「拖延症」≈「执行力差」），关键词管字面精确（术语与符号）；融合用 Σ w/(60＋rank)。
                </Text>
                <Text style={{ fontSize: 15, color: '#8B97A8' }}>对分数尺度不敏感 · 消掉了旧方案的硬编码惩罚</Text>
            </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 12 }}>
            <Box style={{ flex: 1, height: 176, background: '#F7F9FC', borderRadius: 10, border: '1px solid #D6DCE5', borderTop: '4px solid #1E4FA8', padding: '13px 16px', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>评估护栏 · 让质量变成数字</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.55 }}>
                    20 条语料 / 16 条查询，recall@5 ≥ 0.95、recall@1 ≥ 0.75 写成断言，并要求新融合方式不得差于旧加权方案。
                </Text>
                <Text style={{ fontSize: 15, color: '#8B97A8' }}>改任何检索参数，跑一次测试就知道变好还是变坏</Text>
            </Box>
            <Box style={{ flex: 1, height: 176, background: '#F7F9FC', borderRadius: 10, border: '1px solid #D6DCE5', borderTop: '4px solid #1E4FA8', padding: '13px 16px', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>库内检索与向量版本管理</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.55 }}>
                    pgvector 用 &lt;=&gt; 余弦距离算子把排序下推到库内；每条内容记录嵌入模型与维度，换模型只增量重建陈旧条目。
                </Text>
                <Text style={{ fontSize: 15, color: '#8B97A8' }}>VectorStore 抽象两实现：内存索引 ｜ pgvector</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: '10px 40px 14px 40px' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>认知副驾 · Cognitive Copilot</Text>
        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>10 / 27</Text>
    </Box>
</Slide>
