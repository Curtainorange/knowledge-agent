# --- 依赖目录 ---
node_modules/
venv/
__pycache__/
*.py[cod]
.venv/

# --- 构建 / 缓存 ---
dist/
build/
.DS_Store
*.log
Thumbs.db
*.egg-info/

# --- 运行时产物 ---
*.db
*.sqlite3
/backups/          # 数据备份（本地保留，不入库）

# --- 本地模型权重（体积大，用 scripts/fetch_embedding_model.py 按需获取）---
# 锚定根目录，避免误伤代码目录 app/domain/models/
/models/

# --- 上传的书籍文件（用户数据，不入库）---
# 锚定根目录！写 `data/` 会匹配**任意层级**的 data 目录，把 tests/data/ 一起吞掉——
# tests/data/retrieval_eval.json 就是这么被静默漏掉的：本机天天绿，
# 干净检出时 test_retrieval_eval.py 的 6 项直接 ERROR（2026-10-26 修）。
/data/

# --- 环境变量 / 密钥（千万别传）---
.env
.env.*
!.env.example
*.pem
*.key

# --- IDE / 编辑器 ---
.vscode/*
!.vscode/extensions.json

# --- Claude Code 本地状态 ---
.claude/

# --- WorkBuddy 会话/记忆（本地辅助数据，不入库）---
.workbuddy/

# --- slidep（PPT 工具）的本地缓存 / 会话目录 ---
.slidep/
.cache/

# 视频录制的中间帧（可由 record_video.py 重新生成）
output/**/_frames_*/

# 视频分段落与旧版素材（成片由 film_run.py + compose.py 重新生成）
output/认知副驾功能汇报-2026-11-11/video/_segments/
output/认知副驾功能汇报-2026-11-11/video/_旧版_5fps/
